{
  "ROS2 Node (C++)": {
    "prefix": "ros2node",
    "description": "标准 ROS2 C++ 节点模板",
    "body": [
      "#include <rclcpp/rclcpp.hpp>",
      "",
      "class ${1:MyNode} : public rclcpp::Node {",
      "public:",
      "  explicit ${1:MyNode}(const rclcpp::NodeOptions & options)",
      "  : Node(\"${1:MyNode}\", options) {",
      "    // 发布者: ${2:/topic_name}",
      "    // 订阅者: ${3:/topic_name}",
      "    // 服务: ${4:/service_name}",
      "  }",
      "",
      "private:",
      "  // TODO: 实现",
      "};",
      "",
      "int main(int argc, char** argv) {",
      "  rclcpp::init(argc, argv);",
      "  rclcpp::spin(std::make_shared<${1:MyNode}>(rclcpp::NodeOptions()));",
      "  rclcpp::shutdown();",
      "  return 0;",
      "}"
    ]
  },
  "ROS2 Node (Python)": {
    "prefix": "ros2nodepy",
    "description": "标准 ROS2 Python 节点模板",
    "body": [
      "import rclpy",
      "from rclpy.node import Node",
      "",
      "",
      "class ${1:MyNode}(Node):",
      "    def __init__(self):",
      "        super().__init__('${1:MyNode}')",
      "        # 发布者",
      "        # self.pub = self.create_publisher(${2:MsgType}, '${3:/topic}', 10)",
      "        # 订阅者",
      "        # self.sub = self.create_subscription(${4:MsgType}, '${5:/topic}', self.callback, 10)",
      "        self.get_logger().info('${1:MyNode} started')",
      "",
      "    def callback(self, msg):",
      "        self.get_logger().info(f'Reveived: {msg}')",
      "",
      "",
      "def main(args=None):",
      "    rclpy.init(args=args)",
      "    try:",
      "        rclpy.spin(${1:MyNode}())",
      "    finally:",
      "        rclpy.shutdown()",
      "",
      "",
      "if __name__ == '__main__':",
      "    main()"
    ]
  },
  "ROS2 Publisher": {
    "prefix": "ros2pub",
    "description": "ROS2 Publisher 模板",
    "body": [
      "self.pub_ = this->create_publisher<${1:std_msgs::msg::String}>(\"${2:/topic}\", 10);",
      "auto msg = ${1:std_msgs::msg::String}();",
      "msg.data = \"hello\";",
      "this->pub_->publish(msg);"
    ]
  },
  "ROS2 Subscription": {
    "prefix": "ros2sub",
    "description": "ROS2 Subscription 模板",
    "body": [
      "rclcpp::Subscription<${1:std_msgs::msg::String}>::SharedPtr sub_;",
      "",
      "sub_ = this->create_subscription<${1:std_msgs::msg::String}>(",
      "    \"${2:/topic}\", 10,",
      "    [this](const ${1:std_msgs::msg::String}::SharedPtr msg) {",
      "        RCLCPP_INFO(this->get_logger(), \"Heard: %s\", msg->data.c_str());",
      "    });"
    ]
  },
